{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://team3-end2end.github.io/schemas/report-stage-v1.json",
  "title": "End-to-end report stage result v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "status", "generated_at", "data", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "stage": {"enum": ["run", "eda", "preprocessing", "model", "evaluation"]},
    "status": {"enum": ["pending", "complete", "failed"]},
    "generated_at": {"type": ["string", "null"], "format": "date-time"},
    "data": {"type": "object"},
    "error": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["message"],
      "properties": {
        "message": {"type": "string", "minLength": 1},
        "details": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {"properties": {"error": {"type": "object"}}},
      "else": {"properties": {"error": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "complete"}}, "required": ["status"]},
      "then": {
        "allOf": [
          {
            "if": {"properties": {"stage": {"const": "run"}}, "required": ["stage"]},
            "then": {"properties": {"data": {"$ref": "#/$defs/run"}}}
          },
          {
            "if": {"properties": {"stage": {"const": "eda"}}, "required": ["stage"]},
            "then": {"properties": {"data": {"$ref": "#/$defs/eda"}}}
          },
          {
            "if": {"properties": {"stage": {"const": "preprocessing"}}, "required": ["stage"]},
            "then": {"properties": {"data": {"$ref": "#/$defs/preprocessing"}}}
          },
          {
            "if": {"properties": {"stage": {"const": "model"}}, "required": ["stage"]},
            "then": {"properties": {"data": {"$ref": "#/$defs/model"}}}
          },
          {
            "if": {"properties": {"stage": {"const": "evaluation"}}, "required": ["stage"]},
            "then": {"properties": {"data": {"$ref": "#/$defs/evaluation"}}}
          }
        ]
      }
    }
  ],
  "$defs": {
    "shape": {
      "type": "object", "additionalProperties": false,
      "required": ["rows", "columns"],
      "properties": {"rows": {"type": "integer", "minimum": 0}, "columns": {"type": "integer", "minimum": 0}}
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["project_name", "report_title", "run_id", "source_revision", "dataset", "target"],
      "properties": {
        "project_name": {"type": "string"}, "report_title": {"type": "string"},
        "run_id": {"type": "string"}, "source_revision": {"type": ["string", "null"]},
        "dataset": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "path", "period_start", "period_end", "shape"],
          "properties": {
            "name": {"type": "string"}, "path": {"type": "string"},
            "period_start": {"type": ["string", "null"]}, "period_end": {"type": ["string", "null"]},
            "shape": {"$ref": "#/$defs/shape"}
          }
        },
        "target": {
          "type": "object", "additionalProperties": false,
          "required": ["name", "problem_type", "classes"],
          "properties": {
            "name": {"type": "string"}, "problem_type": {"type": "string"},
            "classes": {"type": "array", "items": {"type": "string"}}
          }
        },
        "is_sample": {"type": "boolean", "default": false}
      }
    },
    "eda": {
      "type": "object", "additionalProperties": false,
      "required": ["numeric_feature_count", "categorical_feature_count", "missing_cell_count", "duplicate_row_count", "class_distribution", "findings", "figures"],
      "properties": {
        "numeric_feature_count": {"type": "integer", "minimum": 0},
        "categorical_feature_count": {"type": "integer", "minimum": 0},
        "missing_cell_count": {"type": "integer", "minimum": 0},
        "duplicate_row_count": {"type": "integer", "minimum": 0},
        "class_distribution": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/classDistribution"}},
        "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
        "figures": {"type": "array", "items": {"$ref": "#/$defs/figure"}}
      }
    },
    "classDistribution": {
      "type": "object", "additionalProperties": false, "required": ["label", "count", "ratio"],
      "properties": {"label": {"type": "string"}, "count": {"type": "integer", "minimum": 0}, "ratio": {"type": "number", "minimum": 0, "maximum": 1}}
    },
    "finding": {
      "type": "object", "additionalProperties": false, "required": ["title", "description", "severity", "evidence", "action"],
      "properties": {
        "title": {"type": "string"}, "description": {"type": "string"},
        "severity": {"enum": ["info", "warning", "critical"]},
        "evidence": {"type": "string"}, "action": {"type": "string"}
      }
    },
    "figure": {
      "type": "object", "additionalProperties": false, "required": ["title", "path", "caption", "alt"],
      "properties": {"title": {"type": "string"}, "path": {"type": "string"}, "caption": {"type": "string"}, "alt": {"type": "string"}}
    },
    "preprocessing": {
      "type": "object", "additionalProperties": false,
      "required": ["input_shape", "output_shape", "retention_ratio", "filters", "selected_features", "excluded_features", "derived_features", "transformations"],
      "properties": {
        "input_shape": {"$ref": "#/$defs/shape"}, "output_shape": {"$ref": "#/$defs/shape"},
        "retention_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "filters": {"type": "array", "items": {"$ref": "#/$defs/filter"}},
        "selected_features": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "excluded_features": {"type": "array", "items": {"$ref": "#/$defs/namedReason"}},
        "derived_features": {"type": "array", "items": {"$ref": "#/$defs/namedReason"}},
        "transformations": {"type": "array", "items": {"$ref": "#/$defs/namedReason"}}
      }
    },
    "filter": {
      "type": "object", "additionalProperties": false, "required": ["name", "rule", "before_rows", "after_rows", "removed_rows"],
      "properties": {
        "name": {"type": "string"}, "rule": {"type": "string"},
        "before_rows": {"type": "integer", "minimum": 0}, "after_rows": {"type": "integer", "minimum": 0},
        "removed_rows": {"type": "integer", "minimum": 0}
      }
    },
    "namedReason": {
      "type": "object", "additionalProperties": false, "required": ["name", "reason"],
      "properties": {"name": {"type": "string"}, "reason": {"type": "string"}}
    },
    "model": {
      "type": "object", "additionalProperties": false, "required": ["split", "candidates"],
      "properties": {
        "split": {"$ref": "#/$defs/split"},
        "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modelCandidate"}}
      }
    },
    "split": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "train_samples", "validation_samples", "test_samples", "random_seed"],
      "properties": {
        "strategy": {"type": "string"}, "train_samples": {"type": "integer", "minimum": 0},
        "validation_samples": {"type": "integer", "minimum": 0}, "test_samples": {"type": "integer", "minimum": 0},
        "random_seed": {"type": "integer"}
      }
    },
    "modelCandidate": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "library", "parameters", "training_seconds", "artifact_path", "status"],
      "properties": {
        "id": {"type": "string"}, "name": {"type": "string"}, "library": {"type": "string"},
        "parameters": {"type": "object"}, "training_seconds": {"type": "number", "minimum": 0},
        "artifact_path": {"type": ["string", "null"]}, "status": {"enum": ["complete", "failed"]}
      }
    },
    "evaluation": {
      "type": "object", "additionalProperties": false,
      "required": ["primary_metric", "model_results", "class_metrics", "confusion_matrix", "selected_model_id", "selection_reason", "limitations"],
      "properties": {
        "primary_metric": {"type": "string"},
        "model_results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modelResult"}},
        "class_metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/classMetric"}},
        "confusion_matrix": {"$ref": "#/$defs/confusionMatrix"},
        "selected_model_id": {"type": "string"}, "selection_reason": {"type": "string"},
        "limitations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "modelResult": {
      "type": "object", "additionalProperties": false,
      "required": ["model_id", "accuracy", "macro_precision", "macro_recall", "macro_f1", "weighted_f1", "cv_mean", "cv_std"],
      "properties": {
        "model_id": {"type": "string"}, "accuracy": {"type": "number"},
        "macro_precision": {"type": "number"}, "macro_recall": {"type": "number"},
        "macro_f1": {"type": "number"}, "weighted_f1": {"type": "number"},
        "cv_mean": {"type": "number"}, "cv_std": {"type": "number", "minimum": 0}
      }
    },
    "classMetric": {
      "type": "object", "additionalProperties": false,
      "required": ["label", "precision", "recall", "f1", "support"],
      "properties": {
        "label": {"type": "string"}, "precision": {"type": "number"}, "recall": {"type": "number"},
        "f1": {"type": "number"}, "support": {"type": "integer", "minimum": 0}
      }
    },
    "confusionMatrix": {
      "type": "object", "additionalProperties": false, "required": ["labels", "values", "figure_path"],
      "properties": {
        "labels": {"type": "array", "items": {"type": "string"}},
        "values": {"type": "array", "items": {"type": "array", "items": {"type": "integer", "minimum": 0}}},
        "figure_path": {"type": ["string", "null"]}
      }
    }
  }
}
